{
  "_meta": {
    "description": "Curated profile-extraction rules in a Maigret-inspired shape. Hand-vendored — full upstream Maigret data uses template indirections we don't resolve. Each entry can override detection + add extractors that compose on top of any matching upstream entry (WMN beats Sherlock; Maigret extractors layered on top).",
    "schema": {
      "<site_name>": {
        "url": "URL with {} placeholder for the username",
        "url_main": "Bare host URL",
        "categories": ["optional", "tags"],
        "detection": {
          "e_code": "optional HTTP status asserting profile exists",
          "e_string": "optional substring asserting profile exists",
          "m_code": "optional HTTP status asserting profile is missing",
          "m_string": "optional substring asserting profile is missing"
        },
        "extractors": [
          {
            "field": "one of the canonical vocab",
            "selector": "CSS selector",
            "attribute": "optional attribute name",
            "regex": "optional capture-group-1 regex",
            "multi": false
          }
        ]
      }
    },
    "anon_scrape_notes": "Sites marked 'best-effort' below return JS-only SPA shells anonymously. We can still scrape OG meta tags (server-rendered into the shell). For richer data, the user would need authenticated scraping — out of scope."
  },

  "GitHub": {
    "url": "https://github.com/{}",
    "url_main": "https://github.com",
    "categories": ["dev", "social"],
    "detection": { "e_code": 200, "m_code": 404 },
    "extractors": [
      { "field": "avatar_url",     "selector": "img.avatar-user",                  "attribute": "src" },
      { "field": "display_name",   "selector": "span.vcard-fullname" },
      { "field": "bio",            "selector": "div.user-profile-bio" },
      { "field": "location",       "selector": "li[itemprop=\"homeLocation\"] span" },
      { "field": "external_links", "selector": "li[itemprop=\"url\"] a",           "attribute": "href", "multi": true },
      { "field": "follower_count", "selector": "a[href$=\"?tab=followers\"] span", "regex": "([0-9.,kKmM]+)" }
    ]
  },

  "GitLab": {
    "url": "https://gitlab.com/{}",
    "url_main": "https://gitlab.com",
    "categories": ["dev", "social"],
    "detection": { "e_code": 200, "m_code": 404 },
    "extractors": [
      { "field": "avatar_url",   "selector": "img.gl-avatar", "attribute": "src" },
      { "field": "display_name", "selector": ".user-info .name" },
      { "field": "bio",          "selector": ".user-info .profile-user-bio" },
      { "field": "location",     "selector": ".user-info .profile-user-location" }
    ]
  },

  "Reddit": {
    "url": "https://www.reddit.com/user/{}",
    "url_main": "https://www.reddit.com",
    "categories": ["social"],
    "detection": {
      "e_code": 200,
      "e_string": "<title>",
      "m_string": "Sorry, nobody on Reddit goes by that name"
    },
    "extractors": [
      { "field": "avatar_url",     "selector": "meta[property=\"og:image\"]",       "attribute": "content" },
      { "field": "display_name",   "selector": "meta[property=\"og:title\"]",       "attribute": "content", "regex": "u\\/([\\w-]+)" },
      { "field": "bio",            "selector": "meta[property=\"og:description\"]", "attribute": "content" }
    ]
  },

  "Mastodon Social": {
    "url": "https://mastodon.social/@{}",
    "url_main": "https://mastodon.social",
    "categories": ["social", "fediverse"],
    "detection": {
      "e_code": 200,
      "e_string": "<title>",
      "m_code": 404
    },
    "extractors": [
      { "field": "avatar_url",   "selector": "meta[property=\"og:image\"]",       "attribute": "content" },
      { "field": "display_name", "selector": "meta[property=\"og:title\"]",       "attribute": "content" },
      { "field": "bio",          "selector": "meta[property=\"og:description\"]", "attribute": "content" }
    ]
  },

  "Instagram": {
    "url": "https://www.instagram.com/{}/",
    "url_main": "https://www.instagram.com",
    "categories": ["social", "media", "best-effort"],
    "detection": {
      "e_code": 200,
      "e_string": "og:title"
    },
    "extractors": [
      { "field": "avatar_url",     "selector": "meta[property=\"og:image\"]",       "attribute": "content" },
      { "field": "display_name",   "selector": "meta[property=\"og:title\"]",       "attribute": "content", "regex": "([^\\(]+)" },
      { "field": "bio",            "selector": "meta[property=\"og:description\"]", "attribute": "content" },
      { "field": "follower_count", "selector": "meta[property=\"og:description\"]", "attribute": "content", "regex": "([\\d.,KkMm]+)\\s+Followers" }
    ]
  },

  "Snapchat": {
    "url": "https://www.snapchat.com/add/{}",
    "url_main": "https://www.snapchat.com",
    "categories": ["social", "media", "best-effort"],
    "detection": {
      "e_code": 200,
      "e_string": "og:title",
      "m_code": 404
    },
    "extractors": [
      { "field": "avatar_url",   "selector": "meta[property=\"og:image\"]",       "attribute": "content" },
      { "field": "display_name", "selector": "meta[property=\"og:title\"]",       "attribute": "content" },
      { "field": "bio",          "selector": "meta[property=\"og:description\"]", "attribute": "content" }
    ]
  },

  "TikTok": {
    "url": "https://www.tiktok.com/@{}",
    "url_main": "https://www.tiktok.com",
    "categories": ["social", "media", "best-effort"],
    "detection": {
      "e_code": 200,
      "e_string": "og:title"
    },
    "extractors": [
      { "field": "avatar_url",     "selector": "meta[property=\"og:image\"]",       "attribute": "content" },
      { "field": "display_name",   "selector": "meta[property=\"og:title\"]",       "attribute": "content", "regex": "([^\\(]+)" },
      { "field": "bio",            "selector": "meta[name=\"description\"]",        "attribute": "content" },
      { "field": "follower_count", "selector": "meta[name=\"description\"]",        "attribute": "content", "regex": "([\\d.,KkMm]+)\\s+Followers" }
    ]
  },

  "YouTube": {
    "url": "https://www.youtube.com/@{}",
    "url_main": "https://www.youtube.com",
    "categories": ["social", "media", "best-effort"],
    "detection": {
      "e_code": 200,
      "e_string": "og:title"
    },
    "extractors": [
      { "field": "avatar_url",   "selector": "meta[property=\"og:image\"]",       "attribute": "content" },
      { "field": "display_name", "selector": "meta[property=\"og:title\"]",       "attribute": "content" },
      { "field": "bio",          "selector": "meta[property=\"og:description\"]", "attribute": "content" }
    ]
  }
}
